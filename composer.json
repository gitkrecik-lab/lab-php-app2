{
  "name": "lab/php-app",
  "description": "Aplikacja do ćwiczeń z GitHub Actions",
  "type": "project",
  "license": "MIT",
  "require": { "php": ">=8.2" },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
  "config": { "platform": { "php": "8.2.0" }, "sort-packages": true }
}
